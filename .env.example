# Copy this file to .env and fill in real values. NEVER commit .env.

# "development" for your laptop (allows http cookies and seed-demo).
# Cloud Run uses "production" (set in the Dockerfile).
APP_ENV=development

# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# From the Neon console -> Connect -> connection string (keep ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Local dev server port for `flask run` (macOS AirPlay uses 5000)
FLASK_RUN_PORT=5001
