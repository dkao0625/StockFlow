# Copy this file to .env and fill in real values. NEVER commit .env.

# "development" for your laptop (allows http cookies and seed-demo).
# Cloud Run uses "production" (set in the Dockerfile).
APP_ENV=development

# Neon connection strings (Neon console -> Connect, pooled; keep ?sslmode=require)
# DEV  = used on your laptop (APP_ENV=development)
# PROD = used on Cloud Run (APP_ENV=production; stored in Secret Manager there)
# TEST = used by pytest. Its tables are DELETED on every run, so it must be a
#        separate throwaway database/branch. Leave blank to test on SQLite.
DATABASE_URL_DEV=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL_PROD=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL_TEST=

# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Name shown in the page title, header, and login screen
SITE_NAME=StockFlow

# Default username suggested by `flask --app app create-manager`
ADMIN_USERNAME=your_username

# Local dev server port for `flask run` (macOS AirPlay uses 5000)
FLASK_RUN_PORT=5001
